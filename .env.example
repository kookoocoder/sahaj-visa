# Required for AI Feature 1 (vision pre-check) and nicer phrasing on Features 2–3.
# The form, autosave, payment machine, and rules-engine pre-check work without this.
OPENAI_API_KEY=

# Optional overrides. Feature 1 must stay an OpenAI vision model for eligibility.
OPENAI_VISION_MODEL=gpt-4o
OPENAI_TEXT_MODEL=gpt-4o-mini
